{
    "manifest_version": 3,
    "name": "LMS PTIT Session ID Tool",
    "version": "1.1",
    "description": "Công cụ lấy session_id từ cookie của trang web LMS PTIT.",
    "icons": {
        "48": "icon48.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "48": "icon48.png"
        }
    },
    "permissions": [
        "cookies",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "https://lms.ptit.edu.vn/*"
    ],
    "content_scripts": [
        {
            "matches": ["https://lms.ptit.edu.vn/*"],
            "js": ["content.js"],
            "run_at": "document_start"
        }
    ]
}